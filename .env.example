# Copie ce fichier vers .env. Ne publie jamais le fichier .env reel.
# Les connecteurs de base (demo, RSS, meteo, ICS) n'ont besoin d'aucune cle.

# Chemins OAuth facultatifs pour Google Calendar.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Requis pour les dossiers longs du profil personnel : API Chat Completions HTTPS.
SIGNAL_MATIN_LLM_URL=
SIGNAL_MATIN_LLM_MODEL=
SIGNAL_MATIN_LLM_API_KEY=

# Gmail SMTP : mot de passe d'application, jamais le mot de passe du compte.
GMAIL_SENDER=
GMAIL_RECIPIENT=
GMAIL_APP_PASSWORD=
